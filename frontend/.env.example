# Base URL of the Callwise control-plane API. The dashboard auto-logs-in with the demo
# account and shows REAL data from the backend (an empty state if the API is unreachable).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Demo account the dashboard auto-logs-in with (created by `seed_demo` or your first register).
NEXT_PUBLIC_DEMO_EMAIL=demo@callwise.dev
NEXT_PUBLIC_DEMO_PASSWORD=demo12345
