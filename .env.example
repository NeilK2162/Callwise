# ──────────────────────────────────────────────────────────────────────────
# Callwise — example environment.  Copy to .env and fill real secrets.
# Docker Compose bakes in dev defaults, so .env is OPTIONAL for local `up`.
# In production, secrets come from AWS Secrets Manager / SSM — never a file.
# ──────────────────────────────────────────────────────────────────────────

# --- App ---
APP_ENV=dev                       # dev | staging | prod
LOG_LEVEL=INFO
BASE_URL=http://localhost:8001    # public base used in provider callback URLs

# --- Database (async app conns go through PgBouncer; Alembic uses the direct URL) ---
DATABASE_URL=postgresql+asyncpg://callwise:callwise@pgbouncer:6432/callwise
DATABASE_URL_DIRECT=postgresql+asyncpg://callwise:callwise@postgres:5432/callwise
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Redis (cache, locks, rate-limit buckets, session state, streams broker) ---
REDIS_URL=redis://redis:6379/0

# --- Auth (JWT HS256; secret MUST be >= 32 chars, enforced at startup) ---
JWT_SECRET=dev-only-change-me-to-a-32+char-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
ALLOW_REGISTRATION=true

# --- Object store (S3 / MinIO for audio + transcripts) ---
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=callwise
S3_ACCESS_KEY_ID=callwise
S3_SECRET_ACCESS_KEY=callwise123

# --- Provider selection (mock = no external creds needed; ideal for local + load tests) ---
TELEPHONY_PROVIDER=mock           # mock | exotel | twilio | plivo | telnyx
CONVERSATION_PROVIDER=mock        # mock | elevenlabs | livekit
LLM_PROVIDER=mock                 # mock | azure_openai | openai | anthropic

# --- Telephony provider creds ---
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM=
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM=

# --- Conversation provider creds ---
ELEVENLABS_API_KEY=
ELEVEN_API_KEY=                  # the LiveKit ElevenLabs plugin reads ELEVEN_API_KEY
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=        # HMAC secret for post-call webhook verification
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL   # agent TTS voice
SONIOX_API_KEY=                  # Soniox real-time STT (LiveKit plugin)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Voice agent (LiveKit: Soniox STT → LLM → ElevenLabs TTS) ---
AGENT_LLM_PROVIDER=openai        # openai | anthropic (the conversation brain)
AGENT_LLM_MODEL=gpt-4o-mini
CLINIC_NAME=Bright Smile Dental
INBOUND_CAMPAIGN_ID=             # campaign UUID to attribute inbound calls to (else newest)

# --- Booking (Cal.com live booking) ---
CALCOM_API_KEY=                  # cal_... API key
CALCOM_EVENT_TYPE_ID=            # numeric event-type id the agent books into
CALCOM_TIMEZONE=Asia/Kolkata

# --- LLM provider creds ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_ESCALATION_DEPLOYMENT=   # strong model, used only on low-confidence verifies
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini              # cheap default verify model (Structured Outputs)
OPENAI_ESCALATION_MODEL=              # e.g. gpt-4o-2024-08-06 (low-confidence escalation)
ANTHROPIC_API_KEY=

# --- LLM cost controls (PRD §19) ---
LLM_MAX_OUTPUT_TOKENS=400             # cap verification output
LLM_CONFIDENCE_ESCALATION_THRESHOLD=0.6
TRANSCRIPT_MAX_TURNS=40               # trim long transcripts before the LLM
TRANSCRIPT_MAX_CHARS_PER_TURN=600
LLM_COST_MICROS_PER_1K_TOKENS=200     # blended estimate for the per-campaign spend ceiling

# --- Webhook security ---
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
CONTEXT_TOKEN_SECRET=dev-only-change-me-context-signing-secret
CONTEXT_TOKEN_TTL_SECONDS=600     # ~ max call duration; signed token for call-context

# --- Governors (defaults; per-campaign config overrides these) ---
# Per-provider token bucket: "rate_per_sec:burst_capacity"
RATE_LIMIT_EXOTEL=40:80
RATE_LIMIT_TWILIO=10:20
RATE_LIMIT_ELEVENLABS=50:100
GLOBAL_MAX_CONCURRENT_CALLS=5000
CONCURRENCY_LEASE_TTL_SECONDS=180

# --- Queue / broker (Redis Streams) ---
DIAL_STREAM=dial:stream
DIAL_CONSUMER_GROUP=dialers
VERIFY_STREAM=verify:stream
VERIFY_CONSUMER_GROUP=verifiers
INGEST_STREAM=ingest:stream
INGEST_CONSUMER_GROUP=ingesters
DLQ_STREAM=dlq:stream
QUEUE_MAX_ATTEMPTS=5
QUEUE_CLAIM_IDLE_MS=60000          # XAUTOCLAIM idle threshold for crashed-worker recovery
INGEST_SYNC_SIZE_LIMIT=8388608     # bytes; larger uploads go async via S3 + ingest worker

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=       # e.g. http://otel-collector:4317 (unset = no export)

# --- Reconciler / sweeper ---
RECONCILER_INTERVAL_SECONDS=45
SESSION_STALE_TTL_SECONDS=300

# --- Cost safety ---
DEFAULT_MAX_ATTEMPTS_PER_CONTACT=3
LLM_TOKENS_PER_MINUTE_BUDGET=200000
